<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>StudyPlanner</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>

<header>
  <h1>✦StudyPlanner✦</h1>
  <span>sem 2 · Sam</span>
</header>

<nav>
  <button class="on" onclick="tab('dash',this)">dashboard</button>
  <button onclick="tab('tt',this)">timetable</button>
</nav>

<!-- DASHBOARD -->
<div id="dash" class="pg on">

  <div class="row r4">
    <div class="card stat" onclick="editStat('hours')" title="tap to edit">
      <div class="v g" id="sv-hours">0h</div><div class="l">hours studied</div><div class="edit-hint">tap to update</div>
    </div>
    <div class="card stat"><div class="v b" id="st">0/4</div><div class="l">tasks done</div></div>
    <div class="card stat"><div class="v r" id="se">—</div><div class="l">next exam</div></div>
    <div class="card stat" onclick="editStat('goal')" title="tap to edit">
      <div class="v a" id="sv-goal">0%</div><div class="l">daily goal</div><div class="edit-hint">tap to update</div>
    </div>
  </div>

  <!-- progress bar -->
  <div class="total-bar">
    <h3>overall progress</h3>
    <div class="total-row">
      <div class="total-pct" id="tot-pct">0%</div>
      <div class="total-bg"><div class="total-fill" id="tot-fill" style="width:0%"></div></div>
    </div>
    <div class="total-sub" id="tot-sub">avg of all subjects</div>
  </div>

  <div class="row r2">
    <div class="card">
      <h3>today's tasks</h3>
      <div id="tl"></div>
      <div class="ar">
        <input class="fi" id="nt" placeholder="add a task..." style="flex:2">
        <select class="fi" id="ns"><option>UID</option><option>OOPs</option><option>Discrete Maths</option><option>Linear Algebra</option></select>
        <select class="fi" id="np"><option value="high">high</option><option value="med" selected>med</option><option value="low">low</option></select>
        <button class="btn" onclick="addTask()">+</button>
      </div>
    </div>

    <div class="card">
      <h3>pomodoro timer</h3>
      <div class="timer">
        <div class="tl" id="pl">focus — session 3 of 4</div>
        <div class="td" id="ptd">25:00</div>
        <div class="tbr">
          <button onclick="rst()">reset</button>
          <button class="ts" id="pb" onclick="tog()">start</button>
          <button onclick="skp()">skip</button>
        </div>
        <div class="dots">
          <div class="dot d"></div><div class="dot d"></div><div class="dot ac"></div><div class="dot"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row r2">
    <div class="card">
      <h3>subject progress <span style="font-size:10px;color:var(--muted);font-weight:400;text-transform:none;letter-spacing:0">(from tasks)</span></h3>
      <div id="prog"></div>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px">
      <div class="card">
        <h3>upcoming exams</h3>
        <div id="el"></div>
        <div class="ar" style="display:grid;grid-template-columns:1fr 1fr;gap:7px">
          <input class="fi" id="en" placeholder="exam name">
          <input class="fi" id="ed" type="date">
          <input class="fi" id="ev" placeholder="venue (optional)" style="grid-column:1/-1">
          <button class="btn" onclick="addExam()" style="grid-column:1/-1">+ add exam</button>
        </div>
      </div>
      <div class="card">
        <h3>streak 🔥</h3>
        <div class="sg" id="sg"></div>
        <div class="sn">14 days</div>
        <div class="sl">best: 21 days — keep grinding!</div>
      </div>
    </div>
  </div>
</div>

<!-- TIMETABLE -->
<div id="tt" class="pg">
  <div class="card">
    <h3>weekly timetable <span style="font-size:10px;font-weight:400;color:var(--muted);text-transform:none;letter-spacing:0">— click slot to select, filled to remove</span></h3>
    <div class="ttg" id="ttg"></div>
    <div class="leg" id="leg"></div>
    <div class="ar">
      <select class="fi" id="tday"><option value="0">mon</option><option value="1">tue</option><option value="2">wed</option><option value="3">thu</option><option value="4">fri</option><option value="5">sat</option><option value="6">sun</option></select>
      <select class="fi" id="thr"></select>
      <select class="fi" id="tsub"><option>UID</option><option>OOPs</option><option>Discrete Maths</option><option>Linear Algebra</option></select>
      <button class="btn" onclick="addSlot()">+ add</button>
    </div>
  </div>
</div>

<!-- MODAL -->
<div class="modal" id="modal">
  <div class="mbox">
    <h3 id="mtitle">update</h3>
    <label id="mlabel">value</label>
    <input class="fi" id="minput" type="number" min="0">
    <div class="mrow" style="margin-top:4px">
      <button class="btn sec" onclick="closeModal()">cancel</button>
      <button class="btn" onclick="saveModal()">save</button>
    </div>
  </div>
</div>

<script>
// ── CONFIG ──
var SC={
  'UID':          {c:'#4ade80',cl:'cm',p:{b:'rgba(74,222,128,.15)',t:'#4ade80'}},
  'OOPs':         {c:'#a78bfa',cl:'cp',p:{b:'rgba(167,139,250,.15)',t:'#a78bfa'}},
  'Discrete Maths':{c:'#fbbf24',cl:'cc',p:{b:'rgba(251,191,36,.15)',t:'#fbbf24'}},
  'Linear Algebra':{c:'#22d3ee',cl:'ccs',p:{b:'rgba(34,211,238,.15)',t:'#22d3ee'}}
};
var DAYS=['mon','tue','wed','thu','fri','sat','sun'];
var HRS=['7AM','8AM','9AM','10AM','11AM','12PM','1PM','2PM','3PM','4PM','5PM','6PM','7PM','8PM'];

// ── TABS ──
function tab(id,btn){
  document.querySelectorAll('.pg').forEach(function(p){p.classList.remove('on');});
  document.querySelectorAll('nav button').forEach(function(b){b.classList.remove('on');});
  document.getElementById(id).classList.add('on');btn.classList.add('on');
}

// ── EDITABLE STATS ──
var stats={hours:0,goal:0},editing='';
function editStat(k){
  editing=k;
  document.getElementById('mtitle').textContent=k==='hours'?'hours studied':'daily goal %';
  document.getElementById('mlabel').textContent=k==='hours'?'hours (e.g. 6.5)':'goal % (e.g. 75)';
  document.getElementById('minput').value=stats[k];
  document.getElementById('minput').step=k==='hours'?'0.5':'1';
  document.getElementById('minput').max=k==='hours'?24:100;
  document.getElementById('modal').classList.add('show');
  setTimeout(function(){document.getElementById('minput').focus();},50);
}
function closeModal(){document.getElementById('modal').classList.remove('show');}
function saveModal(){
  var v=parseFloat(document.getElementById('minput').value)||0;
  stats[editing]=v;
  document.getElementById('sv-'+editing).textContent=editing==='hours'?v+'h':v+'%';
  closeModal();
}
document.getElementById('minput').addEventListener('keydown',function(e){if(e.key==='Enter')saveModal();});
document.getElementById('modal').addEventListener('click',function(e){if(e.target===this)closeModal();});

// ── TASKS ──
var tasks=[
  {t:'Lab report — UID',s:'UID',p:'high',d:false},
  {t:'OOPs: Inheritance practice',s:'OOPs',p:'med',d:false},
  {t:'DM: Set theory problems',s:'Discrete Maths',p:'high',d:false},
  {t:'LA: Matrix operations',s:'Linear Algebra',p:'low',d:false}
];
function rTasks(){
  var el=document.getElementById('tl');
  el.innerHTML=tasks.length?'':'<p class="no">no tasks yet — add one!</p>';
  tasks.forEach(function(tk,i){
    var sc=SC[tk.s]||{p:{b:'#333',t:'#aaa'}};
    var d=document.createElement('div');d.className='task';
    d.innerHTML='<input type="checkbox"'+(tk.d?' checked':'')+' onchange="chk('+i+',this)">'+
      '<span class="tn'+(tk.d?' done':'')+'">'+e(tk.t)+'</span>'+
      '<span class="pill" style="background:'+sc.p.b+';color:'+sc.p.t+'">'+tk.s+'</span>'+
      '<span class="badge '+tk.p+'">'+(tk.d?'✓':tk.p)+'</span>'+
      '<button class="xb" onclick="delT('+i+')">✕</button>';
    el.appendChild(d);
  });
  updStat();rProg();
}
function chk(i,cb){tasks[i].d=cb.checked;rTasks();}
function delT(i){tasks.splice(i,1);rTasks();}
function addTask(){
  var t=document.getElementById('nt').value.trim();if(!t)return;
  tasks.push({t:t,s:document.getElementById('ns').value,p:document.getElementById('np').value,d:false});
  document.getElementById('nt').value='';rTasks();
}
document.getElementById('nt').addEventListener('keydown',function(e){if(e.key==='Enter')addTask();});
function updStat(){
  var dn=tasks.filter(function(t){return t.d;}).length;
  document.getElementById('st').textContent=dn+'/'+tasks.length;
}

function rProg(){
  var el=document.getElementById('prog');el.innerHTML='';
  var total=0,validCount=0;
  Object.keys(SC).forEach(function(s){
    var cfg=SC[s];
    var all=tasks.filter(function(t){return t.s===s;});
    var dn=all.filter(function(t){return t.d;}).length;
    var pct=all.length?Math.round(dn/all.length*100):0;
    if(all.length){total+=pct;validCount++;}
    var d=document.createElement('div');d.className='pr';
    d.innerHTML='<div class="pt"><span>'+s+'</span><span><span class="cn">'+dn+'/'+all.length+'&nbsp;</span><b>'+pct+'%</b></span></div>'+
      '<div class="bg"><div class="bf" style="width:'+pct+'%;background:'+cfg.c+'"></div></div>'+
      (!all.length?'<div class="hint">no tasks yet</div>':'');
    el.appendChild(d);
  });

  var avg=validCount?Math.round(total/validCount):0;
  document.getElementById('tot-pct').textContent=avg+'%';
  document.getElementById('tot-fill').style.width=avg+'%';
  document.getElementById('tot-sub').textContent=
    'avg across '+validCount+' subject'+(validCount!==1?'s':'')+' — '+
    tasks.filter(function(t){return t.d;}).length+' of '+tasks.length+' tasks done';
}

// ── EXAMS ──
var exams=[];
function dl(ds){var t=new Date();t.setHours(0,0,0,0);return Math.round((new Date(ds)-t)/864e5);}
function fd(ds){var d=new Date(ds),m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return m[d.getMonth()]+' '+d.getDate();}
function uc(d){return d<=5?'high':d<=14?'med':'low';}
function ucl(d){return d<=5?'r':d<=14?'a':'g';}
function rExams(){
  exams.sort(function(a,b){return new Date(a.dt)-new Date(b.dt);});
  var el=document.getElementById('el'),se=document.getElementById('se');
  if(!exams.length){el.innerHTML='<p class="no">no exams added yet</p>';se.textContent='—';se.className='v b';return;}
  var ft=exams.filter(function(x){return dl(x.dt)>=0;});
  if(ft.length){var d=dl(ft[0].dt);se.textContent=d===0?'today!':d+'d';se.className='v '+ucl(d);}
  el.innerHTML='';
  exams.forEach(function(x,i){
    var d=dl(x.dt),lb=d<0?'past':d===0?'today':d+'d';
    var div=document.createElement('div');div.className='ex';
    div.innerHTML='<span class="ed '+ucl(d)+'">'+fd(x.dt)+'</span>'+
      '<div class="ei"><div class="en">'+e(x.n)+'</div>'+(x.v?'<div class="ev">'+e(x.v)+'</div>':'')+'</div>'+
      '<span class="badge '+uc(d)+'">'+lb+'</span>'+
      '<button class="xb" onclick="delEx('+i+')">✕</button>';
    el.appendChild(div);
  });
}
function addExam(){
  var n=document.getElementById('en').value.trim(),dt=document.getElementById('ed').value,v=document.getElementById('ev').value.trim();
  if(!n||!dt){alert('name and date required');return;}
  exams.push({n:n,dt:dt,v:v});rExams();
  document.getElementById('en').value=document.getElementById('ed').value=document.getElementById('ev').value='';
}
function delEx(i){exams.splice(i,1);rExams();}

// ── POMODORO ──
var rem=25*60,tot=25*60,run=false,iv=null;
function ft2(s){return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');}
function upd(){document.getElementById('ptd').textContent=ft2(rem);}
function tog(){
  run=!run;var b=document.getElementById('pb');
  if(run){b.textContent='pause';iv=setInterval(function(){if(rem>0){rem--;upd();}else{clearInterval(iv);run=false;b.textContent='start';alert('done! take a break 🎉');}},1000);}
  else{clearInterval(iv);b.textContent='start';}
}
function rst(){clearInterval(iv);run=false;rem=tot=25*60;document.getElementById('pb').textContent='start';document.getElementById('pl').textContent='focus — session 3 of 4';upd();}
function skp(){clearInterval(iv);run=false;rem=tot=5*60;document.getElementById('pb').textContent='start';document.getElementById('pl').textContent='break — 5 minutes';upd();}

// ── STREAK ──
var sg=document.getElementById('sg');
['M','T','W','T','F','S','S','M','T','W','T','F','S','S'].forEach(function(d,i){
  var el=document.createElement('div');el.className='sd '+(i<13?'on':'td2');el.textContent=d;sg.appendChild(el);
});

// ── TIMETABLE ──
var TT=[];
for(var di=0;di<7;di++){TT[di]=[];for(var hi=0;hi<HRS.length;hi++)TT[di][hi]=null;}
[[0,1,'UID'],[0,3,'OOPs'],[1,2,'Discrete Maths'],[1,4,'Linear Algebra'],
 [2,1,'OOPs'],[2,5,'UID'],[3,0,'Linear Algebra'],[3,3,'Discrete Maths'],
 [4,2,'UID'],[4,4,'OOPs'],[5,1,'Discrete Maths']].forEach(function(s){TT[s[0]][s[1]]={s:s[2]};});

var thr=document.getElementById('thr');
HRS.forEach(function(h,i){var o=document.createElement('option');o.value=i;o.textContent=h;thr.appendChild(o);});

function rTT(){
  var g=document.getElementById('ttg');g.innerHTML='';
  var td=new Date().getDay(),tc=td===0?6:td-1;
  g.appendChild(document.createElement('div'));
  DAYS.forEach(function(dy,di){
    var el=document.createElement('div');el.className='th'+(di===tc?' tc':'');el.textContent=dy;g.appendChild(el);
  });
  HRS.forEach(function(hr,hi){
    var tl=document.createElement('div');tl.className='tim';tl.textContent=hr;g.appendChild(tl);
    for(var di=0;di<7;di++){
      var sl=TT[di][hi],cell=document.createElement('div');cell.className='tc2';
      if(sl){
        var cfg=SC[sl.s]||{cl:'',c:'#888'};
        cell.classList.add('f',cfg.cl);cell.textContent=sl.s;
        (function(d2,h2){cell.onclick=function(){if(confirm('remove '+TT[d2][h2].s+'?')){TT[d2][h2]=null;rTT();}}})(di,hi);
      }else{
        cell.textContent='+';
        (function(d2,h2){cell.onclick=function(){document.getElementById('tday').value=d2;document.getElementById('thr').value=h2;document.getElementById('tsub').focus();};})(di,hi);
      }
      g.appendChild(cell);
    }
  });
  var leg=document.getElementById('leg');leg.innerHTML='';
  Object.keys(SC).forEach(function(s){
    var li=document.createElement('div');li.className='li';
    li.innerHTML='<div class="ld" style="background:'+SC[s].c+'"></div><span>'+s+'</span>';
    leg.appendChild(li);
  });
}
function addSlot(){
  var di=+document.getElementById('tday').value,hi=+document.getElementById('thr').value,sub=document.getElementById('tsub').value;
  if(TT[di][hi]&&!confirm('replace existing?'))return;
  TT[di][hi]={s:sub};rTT();
}

// ── UTIL ──
function e(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

// ── INIT ──
rTasks();rExams();rTT();
</script>
</body>
</html>
